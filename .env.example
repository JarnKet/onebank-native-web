# Copy to .env.local and adjust. Committed .env holds the shared dev defaults.
VITE_SERVICE_URL=http://10.0.19.65/service3.php
VITE_PAYLOAD_PATH=http://10.0.19.65/b1hybrid/
VITE_ONEBANK_PATH=http://10.0.19.65:7000/
VITE_UPLOAD_PUBLIC_PATH=https://public2.bcel.one/upload/
VITE_SOCKET_HOST=bcel.la
VITE_SOCKET_PORT=8872

# Milliseconds before a call to the core is abandoned. Default 20000.
# VITE_REQUEST_TIMEOUT_MS=20000
# How long a command the core contract lacks waits for the core before the
# in-browser local store answers it instead (ms).
# VITE_UNMAPPED_TIMEOUT_MS=5000

# Extra origins allowed to drive the iframe bridge, comma separated.
# Only needed when b1hybrid or onebank-ui are served from a host the two paths
# above do not name.
# VITE_EXTRA_FRAME_ORIGINS=http://localhost:7000

# Exposes the host-override fields on the login form. Never set in production.
VITE_ENABLE_DEV_OVERRIDES=1
