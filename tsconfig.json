{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    // svelte-check type-checks `.js` sources too (`allowJs`), and without this
    // TypeScript reports that emitting would overwrite `src/main.js` and
    // `vite.config.js`. Nothing here ever emits — Vite does the building.
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "$/*": ["src/*"]
    },
    "types": ["svelte", "vite/client"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "vite.config.js",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", "b1hybrid"]
}
